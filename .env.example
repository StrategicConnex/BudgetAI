# BudgetAI Environment Variables
# Copy this file to .env.local and fill in the values

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== Google AI (Gemini) =====
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key

# ===== OpenRouter (Claude para redacción premium) =====
OPENROUTER_API_KEY=your-openrouter-key

# ===== App Config =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BudgetAI

# ===== Rate Limiting (Vercel KV / Upstash Redis) =====
# Necesario para rate limiting en producción multi-instancia (Vercel).
# Obtené estos valores desde tu dashboard de Vercel KV o Upstash.
# Si no se configuran, se usa un rate-limiter en memoria (solo para desarrollo local).
UPSTASH_REDIS_REST_URL=https://your-region.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# ===== Upload =====
# Supabase Storage se usa directamente, no necesita config adicional
